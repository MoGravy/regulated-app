# ============================================================
# Regulated — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
#
# VERCEL NOTE: Set these WITHOUT the VITE_ prefix in Vercel.
# The app maps them automatically at build time.
# See vite.config.js → define block.
#
# LOCAL DEV NOTE: Vite requires the VITE_ prefix for frontend
# vars. For local dev, use .env.local with VITE_ prefix:
#   VITE_SUPABASE_URL=...
#   VITE_SUPABASE_ANON_KEY=...
# ============================================================

# --- Vercel variable names (use these in Vercel dashboard) ---

# Supabase (public — safe to expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key

# Stripe (publishable key — safe to expose to browser)
STRIPE_PUBLIC_KEY=pk_live_...

# Google Analytics 4 measurement ID (GA Admin → Data streams → web stream → Measurement ID)
# Leave unset to disable GA entirely.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe price IDs (create in Stripe dashboard → Products)
STRIPE_PRICE_MONTHLY=price_monthly_id_here
STRIPE_PRICE_ANNUAL=price_annual_id_here

# App URL (used in Stripe redirect URLs)
APP_URL=https://regulatedapp.co

# --- Server-side only (Vercel serverless functions, never sent to browser) ---

# Stripe secret key
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role key (admin access — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Resend email API key
RESEND_API_KEY=re_...

# From email address
FROM_EMAIL=hello@regulatedapp.co

# Admin secret for the /api/deliver-audio endpoint (choose any strong random string)
ADMIN_SECRET=change-this-to-a-random-string

# ============================================================
# LOCAL DEV — .env.local equivalents (VITE_ prefix required)
# ============================================================
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_STRIPE_PRICE_MONTHLY=price_...
# VITE_STRIPE_PRICE_ANNUAL=price_...
# VITE_APP_URL=http://localhost:3000
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
