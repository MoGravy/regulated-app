# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (public key for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe (secret key - server-side only, Vercel env var, NOT prefixed with VITE_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe dashboard)
VITE_STRIPE_PRICE_MONTHLY=price_monthly_id_here
VITE_STRIPE_PRICE_ANNUAL=price_annual_id_here
VITE_STRIPE_PRICE_CUSTOM_AUDIO=price_custom_audio_id_here

# Resend
RESEND_API_KEY=re_...
VITE_FROM_EMAIL=hello@regulatedapp.co

# App URL (for Stripe redirects)
VITE_APP_URL=https://regulatedapp.co

# Supabase Service Role Key (server-side only, for webhook handlers)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
