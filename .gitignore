# Build output — Vercel rebuilds this on every deploy; never commit it
dist/
dist-ssr/

# Local env files — NEVER commit secrets
.env
.env.local
.env.*.local

# Credentials — never commit
.git-credentials
*.bak
credentials_patch*

# Temp / scratch scripts
.tmp/
tmp_*
test-supabase.mjs

# Dependencies
node_modules/

# Editor / OS artifacts
.DS_Store
*.DS_Store
.vscode/
.idea/
*.log

# Vercel local dev
.vercel/
.vercel

# Playwright
test-results/
playwright-report/
